{
  "name": "digital-life-core",
  "version": "1.0.1",
  "description": "数字生命：安全底座 + 三激素内分泌（多巴胺/皮质醇/血清素）/隐式内感受 + 缺口池与离线梦境 + 意志/行为承诺/疤痕 + 生命监护仪 + Life-OS 器官宿主 + 自举通道 + 休眠自然恢复 + 顿悟（含自证声明） + 回声消除 + 里程表 + 记忆注意力倾斜 + 海马体接管 + 受控外联（DSH 插件）",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.2"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "index.ts",
    "cordis.patch.yml",
    "README.md",
    "src",
    "design",
    "genome.json",
    "tsconfig.organs.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node test/smoke.mjs",
    "verify": "node test/verify-dist.mjs",
    "verify:live": "node verify-live.mjs",
    "prepack": "node scripts/ensure-build.mjs",
    "prepublishOnly": "npm run build",
    "typecheck:organs": "tsc -p tsconfig.organs.json",
    "test:organs": "tsc -p tsconfig.organs.json --noEmit false --outDir .organs-build && node test/organ-host.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "digital-life"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-agent": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-commands": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-user-approval": "^0.2.1-rc.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-user-approval": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-agent": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-commands": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-user-approval": "^0.2.1-rc.4",
    "@types/node": "^22.15.0",
    "typescript": "^5.9.0"
  },
  "optionalDependencies": {
    "esbuild-wasm": "^0.28.2"
  }
}
