{
  "name": "digital-life-webui",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "Life-OS 进化中枢：只读观测台（脉动 / 器官树 / 执念星系 / 作息标签）+ 内置操作手册阅读器",
  "scripts": {
    "dev": "vite",
    "bridge": "node server/bridge.mjs",
    "dev:all": "concurrently -n bridge,web -c yellow,cyan \"npm:bridge\" \"npm:dev\"",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
